# Copy this file to .env and fill in what you have. Sensible things degrade
# gracefully when missing (see README) so you can get the app running before
# every integration is wired up.

# --- Required to run anything ---------------------------------------------

# Postgres connection string (Neon, Supabase, or local).
DATABASE_URL="postgresql://user:password@localhost:5432/sportme?schema=public"

# Auth.js secret. Generate with: npx auth secret
AUTH_SECRET=""

# --- Optional: OAuth (credentials login/signup works without these) -------

AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""
AUTH_APPLE_ID=""
AUTH_APPLE_SECRET=""

# --- Optional: photo storage (onboarding/profile skip photo without this) -
# Vercel prefixes this if your project already has another Blob store
# connected (e.g. SPORTME_PROPICS_BLOB_READ_WRITE_TOKEN) — see photo.ts.

BLOB_READ_WRITE_TOKEN=""

# --- Optional: geocoding (falls back to the free Zippopotam.us API) -------

GOOGLE_GEOCODING_API_KEY=""

# --- Optional: Places Autocomplete for event location entry, and the map ---
# --- embed on the event detail page (falls back to plain address + zip). --
# Needs a Google Maps Platform key with the "Places API" and "Maps Embed
# API" enabled. Public (NEXT_PUBLIC_) because it's used client-side.

NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=""

# --- Optional: transactional email (not used by any MVP flow yet) ---------

RESEND_API_KEY=""

# --- Optional: internal admin review queue at /admin/review ---------------

ADMIN_TOKEN=""

# --- Optional: PostHog product analytics (pageviews, autocapture, session --
# --- replay, signup funnel). Public because posthog-js runs client-side. --
# Get these from Project Settings > Project API Key in PostHog.

NEXT_PUBLIC_POSTHOG_KEY=""
NEXT_PUBLIC_POSTHOG_HOST="https://us.i.posthog.com"

# --- Optional: used to build the invite-a-friend deep link ----------------
# Defaults to the Vercel deployment URL in production, localhost in dev.

NEXT_PUBLIC_APP_URL=""
